{
  "name": "storybook-live-code",
  "version": "0.3.3",
  "description": "MUI-inspired live code blocks for Storybook docs, with compact snippets, expanded source, and a CodeMirror editor.",
  "type": "module",
  "main": "./dist/storybook-live-code.js",
  "module": "./dist/storybook-live-code.js",
  "types": "./dist/index.d.ts",
  "style": "./src/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/storybook-live-code.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6016 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "keywords": [
    "storybook",
    "storybook-addon",
    "live-code",
    "codemirror",
    "docs"
  ],
  "author": "tsvidaphna",
  "license": "MIT",
  "homepage": "https://github.com/tsviser/storybook-live-code-addon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsviser/storybook-live-code-addon.git"
  },
  "bugs": {
    "url": "https://github.com/tsviser/storybook-live-code-addon/issues"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "react-live": "^4.1.8"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.0.1",
    "react": "latest",
    "react-dom": "latest",
    "storybook": "^10.5.5",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
}
